---
import SiteLayout from '../layouts/SiteLayout.astro';
import DownloadPage from '../components/DownloadPage.astro';
import { download } from '../i18n/download';
import { home } from '../i18n/home';
import headExtra from '../content-html/download.head.html?raw';
---
<SiteLayout
  title={download.en.meta.title}
  headExtra={headExtra}
  path="/download"
  getLabel={home.en.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/download' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/download' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/download' },
  ]}
>
  <DownloadPage lang="en" />
</SiteLayout>
