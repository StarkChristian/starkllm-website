---
import SiteLayout from '../layouts/SiteLayout.astro';
import TechPage from '../components/TechPage.astro';
import { tech } from '../i18n/tech';
import { home } from '../i18n/home';
const t = tech.en['tech-local-tools'];
const url = 'https://www.starkllm.com/tech-local-tools';
const og = `<meta property="og:title" content="${t.title}"><meta property="og:description" content="${t.lede}"><meta property="og:url" content="${url}"><meta property="og:type" content="article"><meta property="og:image" content="https://www.starkllm.com/assets/logo.png"><meta name="robots" content="index, follow">`;
---
<SiteLayout
  title={t.title}
  description={t.lede}
  canonical={url}
  headExtra={og}
  lang="en"
  path="/tech-local-tools"
  getLabel={home.en.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/tech-local-tools' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/tech-local-tools' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/tech-local-tools' },
  ]}
>
  <TechPage lang="en" slug="tech-local-tools" />
</SiteLayout>
