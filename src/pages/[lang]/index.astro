---
// The home page in the other languages: /de/ (a separate file so it is built as de/index.html).
import LocalizedPage from '../../components/LocalizedPage.astro';
import { otherLangs, localizedPaths, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return otherLangs.filter((lang) => localizedPaths[lang].includes('/')).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
---
<LocalizedPage lang={lang as Lang} path="/" />
