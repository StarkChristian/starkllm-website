---
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from '../components/Home.astro';
import { home } from '../i18n/home';
import headExtra from '../content-html/index.head.html?raw';
---
<SiteLayout
  title={home.en.meta.title}
  headExtra={headExtra}
  path="/"
  getLabel={home.en.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/' },
  ]}
>
  <Home lang="en" />
</SiteLayout>
