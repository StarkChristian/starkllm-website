---
import SiteLayout from '../layouts/SiteLayout.astro';
import ProductPage from '../components/ProductPage.astro';
import { product } from '../i18n/product';
import { home } from '../i18n/home';
import headExtra from '../content-html/product.head.html?raw';
---
<SiteLayout
  title={product.en.meta.title}
  headExtra={headExtra}
  path="/product"
  getLabel={home.en.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/product' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/product' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/product' },
  ]}
>
  <ProductPage lang="en" />
</SiteLayout>
