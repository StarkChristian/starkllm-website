---
// Every translated page in the default language (English), at the site root: /, /features, /tech-rag, ...
// plus the old addresses that send the visitor on (src/i18n/pages.ts, `redirects`).
import LocalizedPage from '../components/LocalizedPage.astro';
import Redirect from '../components/Redirect.astro';
import { defaultLang, localizedPaths } from '../i18n/ui';
import { pages, redirects, paramOf, pathOfParam } from '../i18n/pages';

export function getStaticPaths() {
  return [
    ...localizedPaths[defaultLang].filter((p) => p in pages).map((p) => ({ params: { page: paramOf(p) }, props: {} })),
    ...Object.entries(redirects).map(([from, r]) => ({ params: { page: paramOf(from) }, props: { to: r.to } })),
  ];
}
const path = pathOfParam(Astro.params.page);
const { to } = Astro.props as { to?: string };
---
{to ? <Redirect lang={defaultLang} to={to} /> : <LocalizedPage lang={defaultLang} path={path} />}
