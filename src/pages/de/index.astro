---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Home from '../../components/Home.astro';
import { home } from '../../i18n/home';
---
<SiteLayout
  title={home.de.meta.title}
  description={home.de.meta.description}
  canonical="https://www.starkllm.com/de/"
  lang="de"
  path="/"
  getLabel={home.de.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/' },
  ]}
>
  <Home lang="de" />
</SiteLayout>
