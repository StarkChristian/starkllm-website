---
import SiteLayout from '../../layouts/SiteLayout.astro';
import HelpPage from '../../components/HelpPage.astro';
import { help } from '../../i18n/help';
import { home } from '../../i18n/home';
---
<SiteLayout
  title={help.de.meta.title}
  description={help.de.meta.description}
  canonical="https://www.starkllm.com/de/help"
  lang="de"
  path="/help"
  getLabel={home.de.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/help' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/help' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/help' },
  ]}
>
  <HelpPage lang="de" />
</SiteLayout>
