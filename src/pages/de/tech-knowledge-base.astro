---
import SiteLayout from '../../layouts/SiteLayout.astro';
import TechPage from '../../components/TechPage.astro';
import { tech } from '../../i18n/tech';
import { home } from '../../i18n/home';
const t = tech.de['tech-knowledge-base'];
const url = 'https://www.starkllm.com/de/tech-knowledge-base';
const og = `<meta property="og:title" content="${t.title}"><meta property="og:description" content="${t.lede}"><meta property="og:url" content="${url}"><meta property="og:type" content="article"><meta property="og:image" content="https://www.starkllm.com/assets/logo.png"><meta name="robots" content="index, follow">`;
---
<SiteLayout
  title={t.title}
  description={t.lede}
  canonical={url}
  headExtra={og}
  lang="de"
  path="/tech-knowledge-base"
  getLabel={home.de.nav.getBtn}
  alternates={[
    { hreflang: 'en', href: 'https://www.starkllm.com/tech-knowledge-base' },
    { hreflang: 'de', href: 'https://www.starkllm.com/de/tech-knowledge-base' },
    { hreflang: 'x-default', href: 'https://www.starkllm.com/tech-knowledge-base' },
  ]}
>
  <TechPage lang="de" slug="tech-knowledge-base" />
</SiteLayout>
