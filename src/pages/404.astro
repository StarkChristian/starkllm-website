---
import SiteLayout from '../layouts/SiteLayout.astro';
import LegacyBody from '../components/LegacyBody.astro';
import Lucy from '../components/Lucy.astro';
import { home } from '../i18n/home';
import { lucy } from '../i18n/lucy';
import head from '../content-html/404.head.html?raw';
import main from '../content-html/404.main.html?raw';
const t = lucy.en;
---
<SiteLayout canonical="" title={"Page Not Found (404) | StarkLLM"} headExtra={head} path="/404" getLabel={home.en.nav.getBtn}>
  <div class="lucy-lost">
    <div class="lucy-walker"><div class="lucy-flip"><Lucy lang="en" state="walk" size={90} uid="lucy-lost" /></div></div>
  </div>
  <p class="lucy-lost-line">{t.lost.line} <a href="/">{t.lost.back}</a></p>
  <LegacyBody html={main} />
</SiteLayout>
