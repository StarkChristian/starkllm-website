---
import { ui, localePath, type Lang } from '../i18n/ui';
const { lang = 'en', path = '/' } = Astro.props as { lang?: Lang; path?: string };
const t = ui[lang].nav;
const items = [
  { href: '/', label: t.home },
  { href: '/product.html', label: t.product },
  { href: '/manual.html', label: t.manual },
  { href: '/download.html', label: t.download },
  { href: '/about.html', label: t.about },
  { href: '/contact.html', label: t.contact },
];
const clean = path.replace(/^\/de(?=\/|$)/, '') || '/';
const isActive = (href: string) => clean === href || (href === '/' && (clean === '/index.html' || clean === '/'));
---
<header>
  <div class="container nav-container">
    <a href={localePath(lang, '/')} class="logo">
      <img src="/assets/logo.png?v=9" alt="StarkLLM Logo" class="logo-img" />
      Stark<span class="text-gradient">LLM</span>
    </a>
    <button class="menu-toggle" id="menuToggle" aria-label={ui[lang].menu}>&#9776;</button>
    <nav>
      <ul class="nav-links" id="navLinks">
        {items.map((i) => (
          <li><a href={localePath(lang, i.href)} class={isActive(i.href) ? 'active' : undefined}>{i.label}</a></li>
        ))}
        <li><a href="https://github.com/homomorphicprivacy/StarkLLM" target="_blank" rel="noopener">{t.github}</a></li>
        <li class="lang-switch">
          {lang === 'en'
            ? <a href={localePath('de', clean)} hreflang="de" lang="de" title="Deutsch">DE</a>
            : <a href={clean} hreflang="en" lang="en" title="English">EN</a>}
        </li>
      </ul>
    </nav>
  </div>
</header>
