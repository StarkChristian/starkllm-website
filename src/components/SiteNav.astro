---
import { ui, languages, langsFor, localePath, type Lang } from '../i18n/ui';
import { SETUP_URL } from '../i18n/home';
const { lang = 'en', path = '/', getLabel } = Astro.props as { lang?: Lang; path?: string; getLabel: string };
const t = ui[lang].nav;
// Offer a language only where this page exists in it; pages that exist once (the legal texts) get no switcher.
const switchTo = langsFor(path).filter((l) => l !== lang);
const items = [
  { href: '/', label: t.home },
  { href: '/product', label: t.product },
  { href: '/manual', label: t.manual },
  { href: '/download', label: t.download },
  { href: '/about', label: t.about },
  { href: '/contact', label: t.contact },
];
---
<nav class="nav" aria-label="Main">
  <a class="brand" href={localePath(lang, '/')}><img src="/assets/logo-mark.webp?v=10" alt="" width="46" height="26" />StarkLLM</a>
  <button class="menu-btn" id="menuBtn" aria-controls="navLinks" aria-expanded="false" aria-label={ui[lang].menu}>&#9776;</button>
  <ul class="nav-links" id="navLinks">
    {items.map((i) => (
      <li><a href={localePath(lang, i.href)} aria-current={i.href === path ? 'page' : undefined}>{i.label}</a></li>
    ))}
    <li><a href="https://github.com/StarkChristian/StarkLLM" target="_blank" rel="noopener">{t.github}</a></li>
    {switchTo.length > 0 && (
      <li class="lang">
        <details>
          <summary aria-label={languages[lang].name} title={languages[lang].name}>{lang.toUpperCase()}</summary>
          <div class="lang-menu">
            {switchTo.map((l) => <a href={localePath(l, path)} hreflang={l} lang={l}>{languages[l].name}</a>)}
          </div>
        </details>
      </li>
    )}
    <li><a class="btn primary small" href={SETUP_URL}>{getLabel}</a></li>
  </ul>
</nav>
