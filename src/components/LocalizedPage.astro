---
// One template for every translated page: picks the body component, title, description and head tags for (lang, path).
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from './Home.astro';
import ProductPage from './ProductPage.astro';
import DownloadPage from './DownloadPage.astro';
import HelpPage from './HelpPage.astro';
import TechPage from './TechPage.astro';
import AndroidPage from './AndroidPage.astro';
import TourPage from './TourPage.astro';
import LegacyBody from './LegacyBody.astro';
import LucyAbout from './LucyAbout.astro';
import { pageMeta } from '../i18n/meta';
import { home } from '../i18n/home';
import { product } from '../i18n/product';
import { download } from '../i18n/download';
import { help } from '../i18n/help';
import { tech } from '../i18n/tech';
import { android } from '../i18n/android';
import { tour } from '../i18n/tour';
import { pages } from '../i18n/pages';
import { absoluteUrl, defaultLang, languages, type Lang } from '../i18n/ui';
import { RELEASE, V } from '../data/release';
import indexHead from '../content-html/index.head.html?raw';
import productHead from '../content-html/product.head.html?raw';
import downloadHead from '../content-html/download.head.html?raw';

const { lang, path } = Astro.props as { lang: Lang; path: string };
// Plain-HTML pages (manual, about, contact): src/content-html/<name>.main[.<lang>].html and <name>.head[.<lang>].html (English has no suffix).
const files = import.meta.glob('../content-html/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const suffix = lang === defaultLang ? '' : `.${lang}`;
const file = (name: string, part: 'main' | 'head') => files[`../content-html/${name}.${part}${suffix}.html`];
const def = pages[path];
const url = absoluteUrl(lang, path);
const esc = (s: string) => s.replaceAll('&', '&amp;').replaceAll('"', '&quot;').replaceAll('<', '&lt;');
// Open Graph tags for pages without a hand-written head (every language except the default one, and the feature pages).
const og = (title: string, description: string | undefined, type = 'website') =>
  `<meta property="og:title" content="${esc(title)}">` +
  (description ? `<meta property="og:description" content="${esc(description)}">` : '') +
  `<meta property="og:url" content="${url}"><meta property="og:type" content="${type}">` +
  `<meta property="og:image" content="https://www.starkllm.com/assets/logo.png"><meta property="og:locale" content="${languages[lang].locale}">` +
  `<meta name="robots" content="index, follow">`;

let title = '';
let description: string | undefined;
let headExtra = '';
// The default language keeps its hand-written head files (description, Open Graph, Twitter card, structured data).
// Their SoftwareApplication item is the same on all three pages; version and installer URL come from the release.
const fillHead = (s: string) => s.replaceAll('{{V}}', V).replaceAll('{{SETUP_URL}}', RELEASE.setup.url);
const raw = lang === defaultLang
  ? ({ home: fillHead(indexHead), product: fillHead(productHead), download: fillHead(downloadHead) } as Record<string, string>)[def.kind]
  : undefined;

if (def.kind === 'home') { ({ title, description } = home[lang].meta as { title: string; description?: string }); }
if (def.kind === 'product') { ({ title, description } = product[lang].meta as { title: string; description?: string }); }
if (def.kind === 'download') { ({ title, description } = download[lang].meta as { title: string; description?: string }); }
if (def.kind === 'help') { ({ title, description } = help[lang].meta as { title: string; description?: string }); }
if (def.kind === 'android') { ({ title, description } = android[lang].meta as { title: string; description?: string }); }
if (def.kind === 'tour') { ({ title, description } = tour[lang].meta as { title: string; description?: string }); }
if (def.kind === 'tech') { const t = tech[lang][def.slug!]; title = t.title; description = t.lede; headExtra = og(t.title, t.lede, 'article'); }
if (def.kind === 'manual' || def.kind === 'about' || def.kind === 'contact') {
  ({ title, description } = pageMeta[lang][def.kind] as { title: string; description?: string });
  const h = file(def.kind, 'head');
  if (h) { headExtra = h; description = undefined; } else headExtra = og(title, description);
}
if (def.kind === 'legal') { const L = pageMeta[lang].legal!; title = L.title; description = L.description; headExtra = og(title, description); }
if (raw) { headExtra = raw; description = undefined; }
else if (['home', 'product', 'download', 'help', 'android', 'tour'].includes(def.kind)) headExtra = og(title, description);
---
<SiteLayout title={title} description={description} headExtra={headExtra} lang={lang} path={path} getLabel={home[lang].nav.getBtn}>
  {def.kind === 'home' && <Home lang={lang} />}
  {def.kind === 'product' && <ProductPage lang={lang} />}
  {def.kind === 'download' && <DownloadPage lang={lang} />}
  {def.kind === 'help' && <HelpPage lang={lang} />}
  {def.kind === 'android' && <AndroidPage lang={lang} />}
  {def.kind === 'tour' && <TourPage lang={lang} />}
  {def.kind === 'tech' && <TechPage lang={lang} slug={def.slug!} />}
  {def.kind === 'manual' && <LegacyBody html={file('manual', 'main').replaceAll('{{V}}', V)} />}
  {def.kind === 'about' && <LegacyBody html={file('about', 'main')} />}
  {def.kind === 'about' && <LucyAbout lang={lang} />}
  {def.kind === 'contact' && <LegacyBody html={file('contact', 'main')} />}
  {def.kind === 'legal' && (
    <>
      <header class="page-hero"><h1>{pageMeta[lang].legal!.h1}</h1><p class="lede">{pageMeta[lang].legal!.lede}</p></header>
      <section class="block">
        <div class="callout" style="margin-top:0"><p>{pageMeta[lang].legal!.notice}</p></div>
        <ul class="check" style="margin-top:1.5rem">
          <li><a href="/privacy-policy" hreflang="en" lang="en">{pageMeta[lang].legal!.privacyEn}</a></li>
          <li><a href="/datenschutz" hreflang="de" lang="de">{pageMeta[lang].legal!.privacyDe}</a></li>
          <li><a href="/impressum" hreflang="de" lang="de">{pageMeta[lang].legal!.imprintDe}</a></li>
        </ul>
      </section>
    </>
  )}
</SiteLayout>
