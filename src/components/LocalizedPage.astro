---
// One template for every translated page: picks the body component, title, description and structured data for (lang, path).
import SiteLayout from '../layouts/SiteLayout.astro';
import Home from './Home.astro';
import FeaturesPage from './FeaturesPage.astro';
import PhonePage from './PhonePage.astro';
import PrivacyPage from './PrivacyPage.astro';
import ChangelogPage from './ChangelogPage.astro';
import AboutPage from './AboutPage.astro';
import DownloadPage from './DownloadPage.astro';
import HelpPage from './HelpPage.astro';
import TechPage from './TechPage.astro';
import LegacyBody from './LegacyBody.astro';
import { pageMeta } from '../i18n/meta';
import { pages } from '../i18n/pages';
import { help } from '../i18n/help';
import { absoluteUrl, defaultLang, type Lang } from '../i18n/ui';
import { metaOf } from '../lib/pagemeta';
import { RELEASE, V } from '../data/release';

const { lang, path } = Astro.props as { lang: Lang; path: string };
// Plain-HTML pages (manual, contact): src/content-html/<name>.main[.<lang>].html (English has no suffix).
const files = import.meta.glob('../content-html/*.main*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const suffix = lang === defaultLang ? '' : `.${lang}`;
const file = (name: string) => files[`../content-html/${name}.main${suffix}.html`];
const def = pages[path];
const { title, description } = metaOf(lang, path);

// Structured data: the app itself on home and download, the help page's questions as an FAQPage.
const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'StarkLLM',
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'ProductivityApplication',
  softwareVersion: V,
  datePublished: RELEASE.published,
  fileSize: `${Math.round(RELEASE.setup.size / 1_000_000)} MB`,
  downloadUrl: RELEASE.setup.url,
  url: absoluteUrl(lang, '/'),
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: { '@type': 'Person', name: 'Christian Stark' },
  inLanguage: lang,
};
const faqPage = () => ({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: help[lang].problems.groups.flatMap((g) => g.items.map((p) => ({
    '@type': 'Question',
    name: p.q.replace(/^\d+\.\s*/, ''),
    acceptedAnswer: { '@type': 'Answer', text: `${p.cause} ${p.fix.join(' ')}` },
  }))),
});
const jsonLd = def.kind === 'home' || def.kind === 'download' ? app : def.kind === 'help' ? faqPage() : undefined;
---
<SiteLayout title={title} description={description} lang={lang} path={path} jsonLd={jsonLd} ogType={def.kind === 'tech' ? 'article' : 'website'}>
  {def.kind === 'home' && <Home lang={lang} />}
  {def.kind === 'features' && <FeaturesPage lang={lang} />}
  {def.kind === 'phone' && <PhonePage lang={lang} />}
  {def.kind === 'privacy' && <PrivacyPage lang={lang} />}
  {def.kind === 'changelog' && <ChangelogPage lang={lang} />}
  {def.kind === 'about' && <AboutPage lang={lang} />}
  {def.kind === 'download' && <DownloadPage lang={lang} />}
  {def.kind === 'help' && <HelpPage lang={lang} />}
  {def.kind === 'tech' && <TechPage lang={lang} slug={def.slug!} />}
  {def.kind === 'manual' && <div class="wrap-wide prose"><LegacyBody html={file('manual').replaceAll('{{V}}', V)} /></div>}
  {def.kind === 'contact' && <div class="wrap prose"><LegacyBody html={file('contact')} /></div>}
  {def.kind === 'legal' && (
    <div class="wrap">
      <header class="page-hero"><h1>{pageMeta[lang].legal!.h1}</h1><p class="lede">{pageMeta[lang].legal!.lede}</p></header>
      <div class="callout"><p>{pageMeta[lang].legal!.notice}</p></div>
      <ul class="check-list" style="margin-top:var(--space-l)">
        <li><a href="/privacy-policy" hreflang="en" lang="en">{pageMeta[lang].legal!.privacyEn}</a></li>
        <li><a href="/datenschutz" hreflang="de" lang="de">{pageMeta[lang].legal!.privacyDe}</a></li>
        <li><a href="/impressum" hreflang="de" lang="de">{pageMeta[lang].legal!.imprintDe}</a></li>
      </ul>
    </div>
  )}
</SiteLayout>
