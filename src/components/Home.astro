---
// Home page (2026): hero with the letter-to-answer loop, three promises, bento of nine features, short clips,
// the privacy diagram, the phone, who it is for, the download and six questions. Text: src/i18n/langs/<lang>/start.ts.
import Icon from './Icon.astro';
import AppShot from './AppShot.astro';
import AppVideo from './AppVideo.astro';
import PhoneFrame from './PhoneFrame.astro';
import PrivacyDiagram from './PrivacyDiagram.astro';
import TrustBar from './TrustBar.astro';
import Faq from './Faq.astro';
import { start, media, common, fill } from '../i18n/site';
import { localePath, languages, type Lang } from '../i18n/ui';
import { hasShot } from '../lib/media';
import { lucy } from '../i18n/lucy';
import { RELEASE, V, SIZE_MB } from '../data/release';

const { lang } = Astro.props as { lang: Lang };
const c = start[lang];
const m = media[lang];
const cm = common[lang];
const L = (p: string) => localePath(lang, p);
const [maj, min] = V.split('.').map(Number);
const has260 = maj > 2 || (maj === 2 && min >= 6); // the news pill only once the release offered is 2.6.0 or newer
const tour = ['v4-inbox', 'v2-web-task', 'v3-terminal', 'v5-privacy'] as const;
const vids = m.videos as Record<string, { title: string; caption: string }>;
const published = new Date(RELEASE.published + 'T12:00:00Z').toLocaleDateString(languages[lang].locale.replace('_', '-'), { dateStyle: 'long', timeZone: 'UTC' });
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {has260 && <a class="news-pill" href={L('/phone')}><b>{c.hero.news}</b>{c.hero.newsText}<Icon name="arrow" size={15} /></a>}
      <h1>{c.hero.h1[0]} <em>{c.hero.h1[1]}</em></h1>
      <p class="lede">{c.hero.lede}</p>
      <div class="btn-row">
        <a class="btn primary" href="#download"><Icon name="download" size={18} />{c.hero.cta1}</a>
        <a class="btn" href="#tour"><Icon name="play" size={16} />{c.hero.cta2}</a>
      </div>
      <p class="hero-meta">{fill(c.hero.meta, { v: V, mb: SIZE_MB })}</p>
      <div class="lucy-say lucy-hero">
        <div class="lucy-fig lucy-slot" data-lucy-slot aria-hidden="true"></div>
        <div class="lucy-bubble" role="status">
          <p>{lucy[lang].hero.line}</p>
          <div class="lucy-btns">
            <button type="button" class="lucy-btn primary" data-lucy-open>{lucy[lang].ask}</button>
            <button type="button" class="lucy-btn lucy-tour-btn" data-lucy-tour>{lucy[lang].tour}</button>
          </div>
        </div>
      </div>
    </div>
    <figure class="hero-media shot">
      <AppVideo name="v1-letter-answer" lang={lang} frame="window" />
      <figcaption class="media-cap">{vids['v1-letter-answer'].caption} {cm.media.demo}</figcaption>
    </figure>
  </div>
</section>

<div class="wrap"><TrustBar lang={lang} /></div>

<section class="section" id="how" aria-labelledby="how-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="how-h">{c.promises.h2}</h2></div>
    <div class="grid-3">
      {c.promises.items.map((p, i) => (
        <article class="promise reveal"><span class="num">0{i + 1} · {p.k}</span><h3>{p.title}</h3><p>{p.text}</p></article>
      ))}
    </div>
  </div>
</section>

<section class="section alt" aria-labelledby="features-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="features-h">{c.bento.h2}</h2><p class="lede">{c.bento.lede}</p></div>
    <div class="bento">
      {c.bento.items.map((t) => (
        <article class:list={['tile reveal', t.size]}>
          <div class="tile-copy"><span class="tag">{t.tag}</span><h3>{t.title}</h3><p>{t.text}</p></div>
          <div class="tile-media"><AppShot name={t.shot} lang={lang} sizes={t.size === 'w4' ? '(max-width: 640px) 100vw, (max-width: 1023px) 100vw, 860px' : '(max-width: 640px) 100vw, (max-width: 1023px) 50vw, 640px'} ratio="16 / 9" /></div>
        </article>
      ))}
    </div>
    <p style="margin-top:var(--space-l)"><a class="link-arrow" href={L('/features')}>{c.bento.more}<Icon name="arrow" size={17} /></a></p>
  </div>
</section>

<section class="section" id="tour" aria-labelledby="tour-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="tour-h">{c.tour.h2}</h2><p class="lede">{c.tour.lede}</p></div>
    <div class="grid-2">
      {tour.map((name) => (
        <figure class="reveal">
          <AppVideo name={name} lang={lang} />
          <figcaption class="media-cap"><b>{vids[name].title}.</b> {vids[name].caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section alt" aria-labelledby="priv-h">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">{cm.nav.privacy}</span><h2 id="priv-h">{c.privacy.h2}</h2><p class="lede">{c.privacy.lede}</p></div>
    <PrivacyDiagram lang={lang} />
    <p style="margin-top:var(--space-l)"><a class="link-arrow" href={L('/privacy')}>{c.privacy.more}<Icon name="arrow" size={17} /></a></p>
  </div>
</section>

<section class="section" aria-labelledby="phone-h">
  <div class="wrap split">
    <div class="stack" style="--flow:var(--space-m)">
      <span class="eyebrow">{c.phone.badge}</span>
      <h2 id="phone-h">{c.phone.h2}</h2>
      <p class="lede">{c.phone.lede}</p>
      <div class="grid-2" style="gap:var(--space-s)">
        <div class="card"><span class="ico-tile"><Icon name="home" /></span><h3>{c.phone.home.title}</h3><p>{c.phone.home.text}</p></div>
        <div class="card"><span class="ico-tile"><Icon name="relay" /></span><h3>{c.phone.away.title}</h3><p>{c.phone.away.text}</p></div>
      </div>
      <p><a class="link-arrow" href={L('/phone')}>{c.phone.more}<Icon name="arrow" size={17} /></a></p>
    </div>
    {/* Until the Android app has a screenshot, the PC side of the phone link (Settings › Phone) stands in, in a window frame. */}
    <div class="reveal">{hasShot('phone-01-chat', lang) ? <PhoneFrame name="phone-01-chat" lang={lang} /> : <AppShot name="12-settings-phone" lang={lang} frame="window" />}</div>
  </div>
</section>

<section class="section alt" aria-labelledby="who-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="who-h">{c.audience.h2}</h2></div>
    <div class="grid-auto">
      {c.audience.items.map((a) => (<div class="card audience reveal"><h3>{a.title}</h3><p>{a.text}</p></div>))}
    </div>
  </div>
</section>

<section class="section" id="download" aria-labelledby="dl-h">
  <div class="wrap">
    <div class="dl-band">
      <div class="dl-band-in">
        <div class="stack" style="--flow:var(--space-s)">
          <h2 id="dl-h" style="font-size:var(--step-4)">{c.download.h2}</h2>
          <p>{c.download.lede}</p>
          <p class="small">{c.download.req}</p>
          <div class="btn-row" style="margin-top:var(--space-m)">
            <a class="btn primary" href={RELEASE.setup.url}><Icon name="download" size={18} />{fill(c.download.btn, { v: V })}</a>
            <a class="btn" href={L('/download')}>{c.download.all}</a>
          </div>
        </div>
        <div class="stack" style="--flow:var(--space-s)">
          <ul class="facts">
            <li><span>{c.download.version}</span><span>{V}</span></li>
            <li><span>{c.download.released}</span><span>{published}</span></li>
            <li><span>{c.download.size}</span><span>{SIZE_MB} MB</span></li>
          </ul>
          <div class="sha"><span>{c.download.sha} · {RELEASE.setup.name}</span><code>{RELEASE.setup.sha256}</code></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="faq-h">
  <div class="wrap-narrow">
    <div class="sec-head"><h2 id="faq-h">{c.faq.h2}</h2></div>
    <Faq items={c.faq.items} />
  </div>
</section>
