---
import { Image } from 'astro:assets';
import { shots, alt as shotAlt } from '../i18n/shots';
import { product, themes, toolSample } from '../i18n/product';
import { SETUP_URL } from '../i18n/home';
import { localePath, type Lang } from '../i18n/ui';
import LucySay from './LucySay.astro';
import { lucy } from '../i18n/lucy';
import { tech, techOrder } from '../i18n/tech';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const c = product[lang];
const S = shots[lang];
const A = shotAlt[lang];
const sizes = '(max-width: 860px) 100vw, 560px';
import Icon from './Icon.astro';
import { rel250 } from '../i18n/release250';
import { rel260 } from '../i18n/release260';
// Release sections only in the languages that have them translated (src/i18n/release260.ts, release250.ts).
const r = rel250[lang];
const n = rel260[lang];
const more = r ? r.product.more.icons.map((ic) => r.news.items.find((it) => it.icon === ic)!).filter(Boolean) : [];
---
<header class="page-hero">
  <p class="eyebrow">{c.hero.eyebrow}</p>
  <h1>{c.hero.h1}</h1>
  <p class="lede">{c.hero.lede}</p>
  {r && (
    <ul class="chips jump">
      {n && <li><a href="#new"><Icon name="phone" size={15} />{n.tag}</a></li>}
      <li><a href="#tasks"><Icon name="web" size={15} />{r.product.tasks.h2}</a></li>
      <li><a href="#phone"><Icon name="phone" size={15} />{r.product.phone.h2}</a></li>
      <li><a href="#life-h"><Icon name="export" size={15} />{c.lifecycle.h2}</a></li>
    </ul>
  )}
</header>

{n && (
  <section class="block" id="new" aria-labelledby="new260-h">
    <span class="tag">{n.tag}</span>
    <h2 id="new260-h">{n.h2}</h2>
    <p class="sec-lede">{n.lede}</p>
    <ul class="fgrid">
      {n.items.map((it) => (
        <li class="fcard">
          <span class="fico"><Icon name={it.icon} /></span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
    <p class="fnote">{n.note} <a href="#phone">{n.more} <Icon name="arrow" size={15} /></a></p>
  </section>
)}

{r && (
  <section class="block" id="tasks" aria-labelledby="tasks-h">
    <span class="tag">{r.product.tasks.tag}</span>
    <h2 id="tasks-h">{r.product.tasks.h2}</h2>
    <p class="sec-lede">{r.product.tasks.lede}</p>
    <div class="duo">
      {[['web', r.product.tasks.web], ['terminal', r.product.tasks.terminal]].map(([ic, part]: any) => (
        <div class="duo-card">
          <div class="duo-head"><span class="fico"><Icon name={ic} /></span><h3>{part.h3}</h3></div>
          <ul class="kv">{part.items.map((i: { k: string; v: string }) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
        </div>
      ))}
    </div>
    <p class="fnote">{r.product.tasks.note}</p>
  </section>
)}

{r && (
  <section class="block" aria-labelledby="more-h">
    <span class="tag">{r.product.more.tag}</span>
    <h2 id="more-h">{r.product.more.h2}</h2>
    <ul class="fgrid">
      {more.map((it) => (
        <li class="fcard">
          <span class="fico"><Icon name={it.icon} /></span>
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </li>
      ))}
    </ul>
  </section>
)}

{r && (
  <section class="block" id="phone" aria-labelledby="phone-h">
    <div class="split phone">
      <div>
        <span class="tag">{r.product.phone.tag}</span>
        <h2 id="phone-h">{r.product.phone.h2}</h2>
        <p class="sec-lede">{r.product.phone.lede}</p>
        <ul class="kv">{r.product.phone.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
      </div>
      <div class="levels">
        <h3><Icon name="phone" />{r.product.phone.levelsH}</h3>
        <ol>
          {r.product.phone.levels.map((l) => (<li><b>{l.k}</b><span>{l.v}</span></li>))}
        </ol>
        <p class="fnote">{r.product.phone.note}</p>
      </div>
    </div>
  </section>
)}

<section class="block" aria-labelledby="life-h">
  <h2 id="life-h">{c.lifecycle.h2}</h2>
  <p class="sec-lede">{c.lifecycle.lede}</p>
  <ol class="pipe four">
    {c.lifecycle.steps.map((s) => (<li><b>{s.k}</b><span>{s.v}</span></li>))}
  </ol>
  <figure class="shot">
    <Image src={S.chat} alt={A.chat} widths={[640, 960, 1180]} sizes="(max-width: 1180px) 100vw, 1180px" format="webp" loading="lazy" />
  </figure>
  <LucySay class="lucy-point" lang={lang} state="point" side="right" size={96} uid="lucy-shot" text={lucy[lang].shot.product} />
</section>

<section class="block" aria-labelledby="let-h">
  <div class="split rev">
    <div>
      <span class="tag">{c.letters.tag}</span>
      <h2 id="let-h">{c.letters.h2}</h2>
      <p class="sec-lede">{c.letters.lede}</p>
      <ul class="kv">{c.letters.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
    </div>
    <figure class="shot flat">
      <Image src={S.inbox} alt={A.inbox} widths={[480, 720, 1120]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
  </div>
</section>

<section class="block" aria-labelledby="dl-h">
  <div class="split">
    <div>
      <span class="tag">{c.deadlines.tag}</span>
      <h2 id="dl-h">{c.deadlines.h2}</h2>
      <p class="sec-lede">{c.deadlines.lede}</p>
      <ul class="kv">{c.deadlines.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
    </div>
    <figure class="shot flat">
      <Image src={S.dashboard} alt={A.dashboard} widths={[480, 720, 1120]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
  </div>
</section>

<section class="block" aria-labelledby="ver-h">
  <span class="tag">{c.verify.tag}</span>
  <h2 id="ver-h">{c.verify.h2}</h2>
  <p class="sec-lede">{c.verify.lede}</p>
  <div class="priv">
    {c.verify.items.map((i) => (<div class="tile auto"><h3>{i.k}</h3><p>{i.v}</p></div>))}
  </div>
  <div class="two shots">
    <figure class="shot flat">
      <Image src={S.sources} alt={A.sources} widths={[480, 720, 960]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
    <figure class="shot flat">
      <Image src={S.warning} alt={A.warning} widths={[480, 720, 960]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
  </div>
</section>

<section class="block" aria-labelledby="lib-h">
  <div class="split">
    <div>
      <span class="tag">{c.library.tag}</span>
      <h2 id="lib-h">{c.library.h2}</h2>
      <p class="sec-lede">{c.library.lede}</p>
      <ul class="kv">{c.library.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
    </div>
    <figure class="shot flat">
      <Image src={S.kb} alt={A.kb} widths={[480, 720, 1120]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
  </div>
  <h3 style="margin-top:4rem;font-size:1.5rem">{c.library.compareH3}</h3>
  <p class="sec-lede">{c.library.compareLede}</p>
  <div class="two">
    {c.library.cards.map((card) => (
      <div class="tile auto">
        <h3>{card.title}</h3>
        <ul>{card.points.map((p) => <li>{p}</li>)}</ul>
        <p class="ex"><b>{card.ex}</b>{card.exText}</p>
      </div>
    ))}
  </div>
</section>

<section class="block" aria-labelledby="ctl-h">
  <div class="split rev">
    <div>
      <span class="tag">{c.control.tag}</span>
      <h2 id="ctl-h">{c.control.h2}</h2>
      <p class="sec-lede">{c.control.lede}</p>
      <ul class="kv">{c.control.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
    </div>
    <figure class="shot flat">
      <Image src={S.settings} alt={A.settings} widths={[480, 720, 1120]} sizes={sizes} format="webp" loading="lazy" />
    </figure>
  </div>
</section>

<section class="block" aria-labelledby="tool-h">
  <div class="split">
    <div>
      <span class="tag">{c.tools.tag}</span>
      <h2 id="tool-h">{c.tools.h2}</h2>
      <p class="sec-lede">{c.tools.lede}</p>
      <ul class="kv">{c.tools.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
    </div>
    <div class="toolcard">
      <div class="t">{c.tools.card.title}</div>
      <span class="badge">{c.tools.card.badge}</span>
      <p>{c.tools.card.text}</p>
      <small>{c.tools.card.example}</small>
      <pre>{JSON.stringify(toolSample, null, 2)}</pre>
      <small>{c.tools.card.foot}</small>
    </div>
  </div>
</section>

<section class="block" aria-labelledby="thm-h">
  <span class="tag">{c.themes.tag}</span>
  <h2 id="thm-h">{c.themes.h2}</h2>
  <p class="sec-lede">{c.themes.lede}</p>
  <div class="themes">
    {themes.map((t) => (
      <div class="theme">
        <div class="sw" style={`background:${t.bg}`}>
          <b style={`background:linear-gradient(90deg,${t.g[0]},${t.g[1]})`}></b>
          <i style={`background:${t.card}`}></i>
        </div>
        <div class="txt"><h3>{t.name}</h3><p>{(c as any).themeTexts?.[t.name] ?? (t as any)[lang] ?? t.en}</p></div>
      </div>
    ))}
  </div>
  <ul class="kv">{c.themes.items.map((i) => (<li><b>{i.k}</b><span>{i.v}</span></li>))}</ul>
</section>

<section class="block" aria-labelledby="sup-h">
  <h2 id="sup-h">{c.superior.h2}</h2>
  <p class="sec-lede">{c.superior.lede}</p>
  <div class="two">
    {c.superior.items.map((i) => (<div class="tile auto"><h3>{i.k}</h3><p>{i.v}</p></div>))}
  </div>
</section>

<section class="block" aria-labelledby="tech-h">
  <h2 id="tech-h">{c.tech.h2}</h2>
  <p class="sec-lede">{c.tech.lede}</p>
  <div class="techs">
    {techOrder.map((slug) => (<a href={localePath(lang, '/' + slug)}><b>{tech[lang][slug].h1}</b><span>{tech[lang][slug].lede}</span></a>))}
  </div>
</section>

<section class="cta-band" aria-labelledby="cta-h">
  <h2 id="cta-h">{c.cta.h2}</h2>
  <p class="sec-lede">{c.cta.text}</p>
  <div class="cta">
    <a class="btn primary" href={SETUP_URL}>{c.cta.installer}</a>
    <a class="btn ghost" href={localePath(lang, '/download')}>{c.cta.all}</a>
    <a class="btn ghost" href={localePath(lang, '/manual')}>{c.cta.manual}</a>
  </div>
</section>
