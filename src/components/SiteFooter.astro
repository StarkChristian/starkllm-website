---
import { ui, localePath, type Lang } from '../i18n/ui';
const { lang = 'en' } = Astro.props as { lang?: Lang };
const f = ui[lang].footer;
---
<footer class="foot">
  <div>
    <a class="brand" href={localePath(lang, '/')} style="padding:0"><img src="/assets/logo-mark.webp?v=10" alt="" width="46" height="26" />StarkLLM</a>
    <p style="margin-top:.8rem">{f.tagline1}</p>
    <p>{f.tagline2}</p>
    <p class="small">{f.disclaimer.map((l, i) => (<>{l}{i < f.disclaimer.length - 1 && <br />}</>))}</p>
  </div>
  <div>
    <h4>{f.related}</h4>
    <a href="https://github.com/StarkChristian/StarkLLM" target="_blank" rel="noopener">{f.repo}</a>
    <a href="https://homomorphicprivacy.com" target="_blank" rel="noopener">homomorphicprivacy.com</a>
    <a href={localePath(lang, '/help')}>{f.help}</a>
  </div>
  <div>
    <h4>{f.legal}</h4>
    {f.legalPage
      ? <a href={localePath(lang, '/legal')}>{f.legalPage}</a>
      : <><a href="/impressum" hreflang="de">{f.impressum}</a><a href="/datenschutz" hreflang="de">{f.privacy}</a></>}
    {lang === 'en' && <a href="/privacy-policy">Privacy policy (English translation)</a>}
    <a href={localePath(lang, '/contact')}>{f.contact}</a>
  </div>
  {f.aiNote && <p class="foot-ai">{f.aiNote.text} <a href="https://github.com/StarkChristian/StarkLLM/issues" target="_blank" rel="noopener">{f.aiNote.issues}</a> · <a href={localePath(lang, '/contact')}>{f.aiNote.contact}</a></p>}
  <div class="foot-bottom">{f.bottom}</div>
</footer>
