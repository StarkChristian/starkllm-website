---
// Download: version, size and SHA-256 live from the GitHub release (src/data/release.ts; release.json offline),
// requirements, install steps with screenshots, the signature check and questions. Text: src/i18n/download.ts.
import Icon from './Icon.astro';
import AppShot from './AppShot.astro';
import Faq from './Faq.astro';
import TrustBar from './TrustBar.astro';
import LucySay from './LucySay.astro';
import { download, GITHUB_URL } from '../i18n/download';
import { localePath, languages, type Lang } from '../i18n/ui';
import { lucy, fill } from '../i18n/lucy';
import { RELEASE } from '../data/release';
import { rel260 } from '../i18n/release260';

const { lang } = Astro.props as { lang: Lang };
const c = download[lang];
const lt = lucy[lang];
const n = rel260[lang];
const [maj, min] = RELEASE.version.split('.').map(Number);
const has260 = maj > 2 || (maj === 2 && min >= 6);
const published = new Date(RELEASE.published + 'T12:00:00Z').toLocaleDateString(languages[lang].locale.replace('_', '-'), { dateStyle: 'long', timeZone: 'UTC' });
// The walkthrough pictures of the older page, mapped to the 2026 media names (the knowledge-base and tool steps have none).
const walkShot: Record<string, string> = { chat: '03-chat-sources', sources: '04-source-page', appearance: '14-themes' };
---
<div class="wrap">
  <header class="page-hero">
    {n && has260 && <a class="news-pill" href={localePath(lang, '/changelog')}><b>{n.tag}</b>{n.pill}<Icon name="arrow" size={15} /></a>}
    <span class="eyebrow">{c.hero.eyebrow}</span>
    <h1>{c.hero.h1}</h1>
    <p class="lede">{c.hero.lede}</p>
    <LucySay class="lucy-news" lang={lang} state="celebrate" size={84} uid="lucy-news" text={`${fill(lt.download.news, { v: RELEASE.version })} ${fill(lt.download.newsDate, { d: published })}`} />
  </header>
</div>

<section class="section tight" aria-labelledby="rel-h" style="padding-top:0">
  <div class="wrap">
    <div class="dl-band">
      <div class="dl-band-in" style="align-items:start">
        <div class="stack" style="--flow:var(--space-m)">
          <h2 id="rel-h" style="font-size:var(--step-3)">{c.release.h2}</h2>
          <ul class="facts">{c.release.facts.map(([k, v]) => (<li><span>{k}</span><span>{v}</span></li>))}</ul>
          <div class="btn-row">
            <a class="btn primary" href={RELEASE.setup.url}><Icon name="download" size={18} />{c.release.installer}</a>
            {RELEASE.portable && <a class="btn" href={RELEASE.portable.url}>{c.release.portable}</a>}
            <a class="btn" href={GITHUB_URL + '/releases'} target="_blank" rel="noopener"><Icon name="github" size={18} />{c.release.github}</a>
          </div>
        </div>
        <div class="stack" style="--flow:var(--space-s)">
          <h3>{c.release.shaH}</h3>
          <p class="small">{c.release.shaLede}</p>
          <div class="sha"><span>{c.release.setupLabel}</span><code>{RELEASE.setup.sha256}</code></div>
          {RELEASE.portable && <div class="sha"><span>{c.release.portableLabel}</span><code>{RELEASE.portable.sha256}</code></div>}
          <p class="small">{c.release.verify}</p>
          <code style="display:block;padding:.6rem .8rem;border-radius:var(--r-sm);background:oklch(22% 0.03 292);border:1px solid oklch(32% 0.04 295);font-size:var(--step--2);overflow-wrap:anywhere">Get-FileHash -Algorithm SHA256 {RELEASE.setup.name}</code>
        </div>
      </div>
    </div>
    <div class="lucy-wrap"><LucySay class="lucy-point" lang={lang} state="point" side="right" size={96} uid="lucy-dl" keep text={lt.download.point} /></div>
  </div>
</section>

<div class="wrap"><TrustBar lang={lang} /></div>

<section class="section" aria-labelledby="setup-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="setup-h">{c.setup.h2}</h2><p class="lede">{c.setup.intro}</p></div>
    <ol class="steps">
      {c.setup.steps.map((s) => (
        <li>
          <b>{s.t}</b>
          <span>{s.v}</span>
          {'code' in s && s.code && <pre><code>{s.code}</code></pre>}
          {'after' in s && s.after && <span>{s.after}</span>}
        </li>
      ))}
    </ol>
    <div class="callout plain" style="margin-top:var(--space-m)">
      <h3>{c.helpCallout.h}</h3>
      <p>{c.helpCallout.text} <a href={localePath(lang, '/help')}>{c.helpCallout.link}</a></p>
    </div>
  </div>
</section>

<section class="section alt" aria-labelledby="pre-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="pre-h">{c.prereq.h2}</h2><p class="lede">{c.prereq.lede}</p></div>
    <dl class="kv grid-2" style="gap:var(--space-s) var(--space-xl)">
      {c.prereq.items.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
    </dl>
    <div class="grid-2" style="margin-top:var(--space-xl);align-items:start">
      <div class="callout" id="signature">
        <h3>{c.smart.h2}</h3>
        <p>{c.smart.text}</p>
        <h4>{c.smart.checkH}</h4>
        <ol>{c.smart.check.map((li) => <li>{li}</li>)}</ol>
        <p class="small">{c.smart.dlls}</p>
      </div>
      <div class="stack" style="--flow:var(--space-s)">
        <div class="callout warn"><h3>{c.smart.warnH}</h3><p>{c.smart.warn}</p></div>
        <div class="callout plain"><h3>{c.notes.h}</h3>{c.notes.items.map((x) => <p>{x}</p>)}</div>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="walk-h">
  <div class="wrap">
    <div class="sec-head"><h2 id="walk-h">{c.walk.h2}</h2><p class="lede">{c.walk.lede}</p></div>
    <div class="grid-2" style="gap:var(--space-xl) var(--space-l)">
      {c.walk.steps.filter((s) => s.kind in walkShot).map((s) => (
        <figure class="reveal">
          <AppShot name={walkShot[s.kind]} lang={lang} frame="window" sizes="(max-width: 860px) 100vw, 560px" />
          <figcaption class="media-cap"><b>{s.t}.</b> {s.v}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<section class="section alt" aria-labelledby="faq-h">
  <div class="wrap-narrow">
    <div class="sec-head"><h2 id="faq-h">{c.faq.h2}</h2></div>
    <Faq items={c.faq.items} />
  </div>
</section>

<section class="section tight" aria-labelledby="con-h">
  <div class="wrap">
    <div class="callout plain" style="padding:var(--space-l)">
      <h2 id="con-h">{c.contribute.h2}</h2>
      <p>{c.contribute.text}</p>
      <div class="btn-row">
        <a class="btn" href={GITHUB_URL} target="_blank" rel="noopener"><Icon name="github" size={18} />GitHub: StarkChristian/StarkLLM</a>
        <a class="btn ghost" href="mailto:info@starkllm.com">{c.contribute.mail}: info@starkllm.com</a>
      </div>
      <p class="small muted">{c.contribute.repo}</p>
    </div>
  </div>
</section>
