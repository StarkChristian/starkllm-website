---
// Technology pages (/tech-*): what it is, why it matters, how StarkLLM does it. Text: src/i18n/tech.ts.
import Icon from './Icon.astro';
import AppShot from './AppShot.astro';
import CtaBand from './CtaBand.astro';
import LucySay from './LucySay.astro';
import { tech, techLabels, techOrder, type TechSlug } from '../i18n/tech';
import { localePath, type Lang } from '../i18n/ui';
import { lucy } from '../i18n/lucy';

const { lang, slug } = Astro.props as { lang: Lang; slug: TechSlug };
const t = tech[lang][slug];
const l = techLabels[lang];
const lt = lucy[lang];
const pointText = lt.shot[slug];
const talkText = slug === 'tech-privacy' ? lt.privacy : slug === 'tech-local-models' ? lt.localModels : '';
const others = techOrder.filter((s) => s !== slug);
// The older screenshot keys, mapped to the 2026 media names (the knowledge-base picture has no planned successor).
const shotName: Record<string, string> = { chat: '03-chat-sources', settings: '15-settings-models', appearance: '14-themes' };
const shot = t.shot ? shotName[t.shot] : undefined;
---
<div class="wrap">
  <header class="page-hero">
    <span class="eyebrow">{t.eyebrow}</span>
    <h1>{t.h1}</h1>
    <p class="lede">{t.lede}</p>
    {talkText && <LucySay lang={lang} state="talk" size={110} uid="lucy-talk" keep text={talkText} />}
  </header>

  <section class="tech-body grid-2" style="align-items:start;gap:var(--space-2xl)">
    <div class="tech-text stack" style="--flow:var(--space-l)">
      {t.sections.map((s) => (
        <div class="stack" style="--flow:var(--space-2xs)">
          <h2 style="font-size:var(--step-2)">{s.h}</h2>
          {s.p && <p class="muted" style="color:var(--fg-2)">{s.p}</p>}
          {s.list && <ul class="check-list">{s.list.map((i) => <li>{i}</li>)}</ul>}
        </div>
      ))}
    </div>
    {shot && (
      <div class="feature-media" style="position:sticky;top:6rem">
        <figure><AppShot name={shot} lang={lang} frame="window" alt={t.shotAlt} sizes="(max-width: 860px) 100vw, 560px" /></figure>
        {pointText && <LucySay class="lucy-point" lang={lang} state="point" side="right" size={96} uid="lucy-shot" text={pointText} />}
      </div>
    )}
  </section>
</div>

<section class="section" aria-labelledby="more-h">
  <div class="wrap">
    <h2 id="more-h" style="font-size:var(--step-3);margin-bottom:var(--space-m)">{l.more}</h2>
    <div class="tech-links">
      {others.map((o) => (<a href={localePath(lang, '/' + o)}><b>{tech[lang][o].h1}</b><span>{tech[lang][o].lede}</span></a>))}
    </div>
  </div>
</section>
<CtaBand lang={lang} />
